---
import Base from '../layouts/Base.astro';
import apis from '../data/apis.json';
import categories from '../data/categories.json';
const verifiedCount = apis.filter((a) => a.status === 'موثق جزئيا').length;
const title = 'كل النماذج — دليل النماذج المجانية';
const description = 'قائمة كاملة بالإدخالات في الدليل، مرتبة حسب الفئة، مع نوع المجانية والحد والحالة.';
---
<Base title={title} description={description} canonical="/apis/">
<h1 class="text-3xl font-bold">كل النماذج</h1>
<p class="mt-2 text-slate-500">عدد الإدخالات الحالية: {apis.length}، منها {verifiedCount} موثقا جزئيا من صفحات رسمية، والباقي قيد التحقق.</p>
{categories.categories.map((cat) => {
  const list = apis.filter((a) => a.category === cat.id);
  return (
  <section class="mt-8">
  <h2 class="text-xl font-bold">{cat.label} ({list.length})</h2>
  <ul class="mt-3 space-y-2">
  {list.map((a) => <li class="rounded-2xl border border-slate-200 bg-white p-3 dark:border-slate-800 dark:bg-slate-900"><a class="font-bold text-blue-600" href={`/apis/${a.id}/`}>{a.name}</a> — {a.provider} · {a.free_type} · {a.free_limit} · {a.status}{a.offer_temporary ? ' · ⏳ عرض مؤقت' : ''} · <a class="text-blue-600" href={a.key_url} rel="noopener" target="_blank">{a.key_url_kind === 'official_site' ? 'صفحة المزود الرسمية ↗' : 'احصل على المفتاح ↗'}</a></li>)}
  </ul>
  </section>
  );
})}
</Base>
