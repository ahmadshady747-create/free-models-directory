---
import Base from '../layouts/Base.astro';
import apis from '../data/apis.json';
import categories from '../data/categories.json';
import changelog from '../data/changelog.json';
import { getLastUpdated } from '../lib/changelog.mjs';
const lastUpdated = getLastUpdated(changelog);
const playgroundCount = apis.filter((a) => a.playground_status === 'implemented').length;
const tempCount = apis.filter((a) => a.offer_temporary).length;
const verifiedCount = apis.filter((a) => a.status === 'موثق جزئيا').length;
const title = 'دليل النماذج المجانية — طبقات مجانية موثقة لنماذج الذكاء الاصطناعي';
const description = 'دليل عربي لـ APIs التي تشغّل نماذج ذكاء اصطناعي فقط، مع نوع المجانية وحدودها وتاريخ آخر تحقق وسجل تغييرات يومي.';
const jsonLd = { '@context': 'https://schema.org', '@type': 'WebApplication', name: title, description, applicationCategory: 'DeveloperApplication', operatingSystem: 'Web' };
---
<Base title={title} description={description} canonical="/">
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<section class="rounded-3xl bg-blue-600 p-6 text-white sm:p-8">
<h1 class="text-2xl font-bold sm:text-3xl">ابحث عن API لنموذج ذكاء اصطناعي مجاني، دون أن تنخدع بالرصيد التجريبي</h1>
<p class="mt-3 max-w-3xl">نماذج ذكاء اصطناعي فقط، لا APIs عامة. كل بطاقة تفرّق بين طبقة مجانية دائمة ورصيد تجريبي.</p>
<p class="mt-3 text-sm font-bold">لا ننشر مفاتيح ولا نخزنها؛ مفتاحك من المزود الرسمي فقط.</p>
<ul class="mt-4 space-y-1 text-sm">
<li>✓ حد مجاني مكتوب لكل مفتاح، مع نطاقه ونوعه — لا وعد عام بلا رقم.</li>
<li>✓ جرّب من متصفحك بمفتاحك أنت: طلبك يذهب من المتصفح إلى المزود مباشرة.</li>
<li>✓ كل حد موثق بمصدر رسمي؛ وما لم يثبت يبقى مكتوبا «غير مؤكد».</li>
</ul>
<dl class="mt-5 grid grid-cols-2 gap-3 text-center sm:grid-cols-4">
<div class="rounded-2xl bg-white/15 p-3"><dt class="text-xs">إدخال في الدليل</dt><dd class="mt-1 text-xl font-bold">{apis.length}</dd></div>
<div class="rounded-2xl bg-white/15 p-3"><dt class="text-xs">موثق جزئيا رسميا</dt><dd class="mt-1 text-xl font-bold">{verifiedCount}</dd></div>
<div class="rounded-2xl bg-white/15 p-3"><dt class="text-xs">بيئة تنفيذ من المتصفح</dt><dd class="mt-1 text-xl font-bold">{playgroundCount}</dd></div>
<div class="rounded-2xl bg-white/15 p-3"><dt class="text-xs">عرض مؤقت</dt><dd class="mt-1 text-xl font-bold">{tempCount}</dd></div>
</dl>
<p class="mt-4"><a href="#search-section" class="inline-flex min-h-12 items-center rounded-full bg-white px-5 py-2 text-sm font-bold text-blue-700">ابدأ البحث ↓</a></p>
</section>

<section class="mt-6 rounded-3xl border border-blue-200 bg-blue-50 p-4 dark:border-blue-800 dark:bg-blue-950/40">
<h2 class="font-bold text-lg">وكيل الدليل — فوق بيئات التنفيذ، لا بدلاً منها</h2>
<p class="mt-1 text-sm">اكتب ما تريد بناءه، فيحصل على توصيات محلية بلا مفتاح من فهرس الدليل، ثم — إن أدخلت مفتاحك ومعرّف نموذجك — يسأل نموذج محادثة تختاره، ثم يرسل مهمة إلى بيئة تنفيذ المزود دون إرسال تلقائي.</p>
<a class="btn-primary mt-3" href="/agent/">افتح وكيل الدليل</a>
</section>

<section id="search-section" class="mt-6 rounded-3xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900">
<label for="search" class="block font-bold">ابحث أولاً باسم المزود أو النموذج</label>
<input id="search" type="search" autocomplete="off" placeholder="مثال: OpenRouter، صورة، ترجمة…" class="mt-2 w-full rounded-full border border-slate-300 px-4 py-3 text-base dark:border-slate-700 dark:bg-slate-950" />
<div class="mt-3 flex flex-wrap gap-2" role="group" aria-label="تصفية حسب الفئة">
<button type="button" data-cat="" aria-pressed="true" class="cat-chip rounded-full bg-blue-600 px-4 py-2 text-sm text-white">الكل</button>
{categories.categories.map((c) => <button type="button" data-cat={c.id} aria-pressed="false" class="cat-chip rounded-full border border-slate-300 px-4 py-2 text-sm dark:border-slate-700">{c.label}</button>)}
</div>
<div class="mt-3 flex flex-wrap items-center gap-3">
<label for="filter-free" class="sr-only">تصفية حسب نوع المجانية</label>
<select id="filter-free" class="rounded-full border border-slate-300 px-3 py-3 text-sm dark:border-slate-700 dark:bg-slate-950">
<option value="">كل أنواع المجانية</option>
<option value="طبقة مجانية دائمة">طبقة مجانية دائمة</option>
<option value="رصيد تجريبي مؤقت">رصيد تجريبي مؤقت</option>
<option value="فترة تجريبية محدودة">فترة تجريبية محدودة</option>
<option value="غير مؤكد">غير مؤكد</option>
</select>
<label class="flex min-h-12 items-center gap-2 rounded-full border border-amber-300 px-4 py-2 text-sm dark:border-amber-700"><input id="filter-temp" type="checkbox" /> عروض مؤقتة فقط</label>
</div>
<p id="result-count" aria-live="polite" class="mt-3 text-sm text-slate-500"></p>
</section>

<section class="mt-6">
<div id="cards" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
{apis.map((api) => {
  const cat = categories.categories.find((c) => c.id === api.category);
  const searchText = [api.id, api.name, api.provider, api.description_ar, ...api.models.map((m) => m.name), ...api.tags].join(' ');
  const hasPlayground = api.playground_status === 'implemented';
  return (
  <article class="api-card rounded-3xl border border-slate-200 bg-white p-4 dark:border-slate-800 dark:bg-slate-900"
    data-search={searchText} data-category={api.category} data-free={api.free_type} data-temp={api.offer_temporary ? 'true' : 'false'} data-expires={api.offer_expires_at || ''} data-name={api.name} data-href={`/apis/${api.id}/`}>
    <h2 class="font-bold text-lg">{api.name}{api.offer_temporary && <span class="ms-2 text-sm font-bold text-amber-700 dark:text-amber-300">⏳ عرض مؤقت</span>}</h2>
    <p class="text-sm text-slate-500">{api.provider} · {cat?.label}</p>
    <p class="mt-2 text-sm">{api.description_ar}</p>
    <ul class="mt-3 space-y-1 text-sm">
      <li>نوع المجانية: <strong>{api.free_type}</strong></li>
      <li>الحد المجاني: <strong>{api.free_limit}</strong></li>
      <li>الحالة: <strong>{api.status}</strong></li>
    </ul>
    <p class="mt-2 text-sm">{hasPlayground ? 'بيئة تنفيذ النماذج متاحة من المتصفح.' : 'بدون بيئة تنفيذ النماذج في المتصفح — صفحة التفاصيل تشرح السبب.'}</p>
    <a class="btn-primary mt-4 w-full" href={`/apis/${api.id}/`}>{hasPlayground ? 'فتح التفاصيل والتجربة' : 'فتح التفاصيل'}</a>
    {api.key_url && <a class="mt-2 flex min-h-12 items-center justify-center text-sm font-bold text-blue-600" href={api.key_url} rel="noopener" target="_blank">{api.key_url_kind === 'official_site' ? 'صفحة المزود الرسمية ↗' : 'احصل على المفتاح ↗'}</a>}
  </article>
  );
})}
</div>
<div id="no-results" class="mt-4 hidden rounded-3xl border border-amber-300 bg-amber-50 p-4 dark:border-amber-700 dark:bg-amber-950/40" role="status">
<p class="font-bold">لا نتائج مطابقة لهذه التصفية.</p>
<p id="no-results-why" class="mt-1 text-sm text-slate-600 dark:text-slate-300"></p>
<p id="no-results-suggestion" class="mt-3 text-sm"></p>
<button id="reset-filters" type="button" class="mt-3 min-h-12 rounded-full bg-blue-600 px-5 py-2 text-sm font-bold text-white">إعادة تعيين البحث والتصفية</button>
</div>
<p class="mt-6 text-sm text-slate-500">آخر تحديث للقائمة: <strong>{lastUpdated}</strong> · <a class="text-blue-600" href="/changelog/">سجل التغييرات اليومي</a> · <a class="text-blue-600" href="/methodology/">المنهجية</a></p>
</section>

<script is:inline src="/filters.js" defer></script>
</Base>
